# Where the contact and boiler-survey forms POST.
# Both forms use this single endpoint. Leave it unset and the forms validate but
# tell visitors to call instead — so set it before launch.
#
# Examples:
#   Formspree    https://formspree.io/f/xxxxxxxx
#   Web3Forms    https://api.web3forms.com/submit   (also set PUBLIC_FORM_ACCESS_KEY)
#   Namecheap    https://okplumbing.co.uk/form.php  (your own PHP mail handler)
PUBLIC_FORM_ENDPOINT=

# Web3Forms only. The form's public access key, from app.web3forms.com.
# It is posted with every submission and is visible in the page source by
# design — it identifies the form, it does not authorise anything.
PUBLIC_FORM_ACCESS_KEY=

# Google Maps Embed API key. Optional.
# Without it the map falls back to the keyless Google embed, which works but is
# not a supported Google API — get a key before launch.
# https://console.cloud.google.com → enable "Maps Embed API" → create an API key
# → restrict it to the okplumbing.co.uk HTTP referrer.
PUBLIC_GOOGLE_MAPS_KEY=
