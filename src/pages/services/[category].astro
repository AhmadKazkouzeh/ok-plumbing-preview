---
/**
 * One page per service category, generated from SERVICES in src/data/site.ts.
 *
 * Adding a category is a data edit — a route, a home card, a footer link, a
 * breadcrumb and an entry in the offer catalog all follow from it.
 */
import type { GetStaticPaths } from 'astro';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import Photo from '~/components/Photo.astro';
import ServiceList from '~/components/ServiceList.astro';
import { BUSINESS, CONTACT_ROUTE, SERVICES, SITE_URL } from '~/data/site';

export const getStaticPaths = (() =>
  SERVICES.map((service) => ({
    // href is '/services/<slug>/' — take the slug back off it so the route and
    // the data can never drift apart.
    params: { category: service.href.replace('/services/', '').replace(/\/$/, '') },
    props: { service },
  }))) satisfies GetStaticPaths;

const { service } = Astro.props;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_URL}/services/` },
      {
        '@type': 'ListItem',
        position: 3,
        name: service.name,
        item: `${SITE_URL}${service.href}`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    description: service.description,
    provider: { '@id': `${SITE_URL}/#business` },
    areaServed: { '@type': 'City', name: 'London' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: service.name,
      itemListElement: [
        ...service.domestic,
        ...service.commercial,
        ...(service.specialised ?? []),
      ].map((item) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: item.name },
      })),
    },
  },
];

const isBoilers = service.icon === 'boiler';
---

<Base title={service.title} description={service.description} schema={schema}>
  <section class="border-b border-ink/8 bg-tint px-6 pt-[clamp(40px,5vw,56px)] pb-[clamp(48px,5vw,64px)]">
    <div class="mx-auto max-w-[1240px]">
      <nav aria-label="Breadcrumb" class="mb-[22px] text-[12.5px] font-semibold text-meta">
        <ol class="flex list-none flex-wrap gap-1 p-0">
          <li class="flex gap-1">
            <a href="/" class="text-meta hover:text-ink">Home</a><span aria-hidden="true"
              >/</span
            >
          </li>
          <li class="flex gap-1">
            <a href="/services/" class="text-meta hover:text-ink">Services</a><span
              aria-hidden="true">/</span
            >
          </li>
          <li>
            <span class="font-bold text-blue" aria-current="page">{service.name}</span>
          </li>
        </ol>
      </nav>

      <div class="autogrid items-center gap-[clamp(32px,4vw,52px)]" style="--min:320px">
        <div>
          <p class="mb-5 flex items-center gap-3">
            <span class="flex size-[46px] items-center justify-center rounded-tile bg-orange text-ink">
              <Icon name={service.icon} />
            </span>
            <span class="text-[11.5px] font-extrabold tracking-[.09em] uppercase text-meta">
              {service.number}
            </span>
          </p>

          <h1 class="h1 mb-[18px]" style="font-size:clamp(34px,4.6vw,54px)">{service.name}</h1>

          <p class="lede m-0 mb-7 max-w-[52ch] text-muted" style="font-size:clamp(16px,1.4vw,18px)">
            {service.intro}
          </p>

          <div class="flex flex-wrap gap-3">
            <a href={CONTACT_ROUTE} class="btn btn-primary" style="padding:16px 26px">
              Get a free quote
            </a>
            <a
              href={`tel:${BUSINESS.mobile.tel}`}
              data-track="call"
              class="btn btn-outline"
              style="padding:16px 26px"
            >
              Call {BUSINESS.mobile.display}
            </a>
          </div>
        </div>

        <Photo
          slug={service.photoSlug}
          caption={service.photoCaption}
          alt={service.photoAlt}
          ratio="4/3"
          radius={14}
          eager
          width={720}
          sizes="(max-width: 860px) 100vw, 44vw"
        />
      </div>
    </div>
  </section>

  <section class="section-sm bg-white px-6">
    <div class="mx-auto grid max-w-[1240px] gap-[clamp(32px,4vw,48px)]">
      <ServiceList title="For your home" items={service.domestic} />

      {
        service.specialised && (
          <div class="rounded-panel border border-blue/20 bg-pale p-[clamp(24px,3vw,34px)]">
            <ServiceList title="Jobs people ask for by name" items={service.specialised} tone="pale" />
          </div>
        )
      }

      <div class="rounded-panel border border-ink/10 bg-tint p-[clamp(24px,3vw,34px)]">
        <ServiceList title="For business and property managers" items={service.commercial} />
      </div>

      {
        isBoilers && (
          <p class="m-0 text-[15px] font-semibold">
            <a
              href="/services/boiler-installation-repairs/"
              class="font-extrabold text-blue underline underline-offset-2"
            >
              More on boiler installation and repairs →
            </a>
          </p>
        )
      }
    </div>
  </section>

  <section class="bg-tint px-6 py-[clamp(40px,5vw,64px)]">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-5">
      <div>
        <h2 class="m-0 mb-2 text-[clamp(24px,2.8vw,32px)] font-extrabold tracking-[-.03em]">
          Not sure which of these you need?
        </h2>
        <p class="m-0 text-base font-medium text-body">
          Describe it on the phone and we will tell you before anyone visits. Free quote, fixed
          price, no callout charge on quoted work.
        </p>
      </div>
      <a href={CONTACT_ROUTE} class="btn btn-primary" style="padding:16px 28px">
        Get a free quote
      </a>
    </div>
  </section>
</Base>
