---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Photo from '~/components/Photo.astro';
import { AIRCON_CHIPS, BUSINESS, CONTACT_ROUTE, SERVICES } from '~/data/site';
---

<Base
  title="Our Services | Plumbing, Heating & Boilers | OK Plumbing"
  description="Six services across London: boilers, central heating, plumbing repairs, servicing and CP12s, bathroom installations and air conditioning installation."
>
  <PageHeader
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
    title="Everything we do, in one place"
    titleClass="max-w-[20ch]"
    intro="Six services across domestic and commercial property in Greater London. Free quotes, fixed written prices and Gas Safe registered engineers on every gas job."
  />

  <section class="section-sm bg-white px-6">
    <ul class="mx-auto grid max-w-[1240px] list-none gap-[18px] p-0">
      {
        SERVICES.map((s) => {
          const isAircon = s.icon === 'aircon';
          return (
            <li
              class:list={[
                'autogrid items-center gap-7 rounded-panel p-[clamp(24px,3vw,34px)]',
                isAircon && 'border border-blue/20 bg-pale',
                !isAircon && 'border border-ink/10',
              ]}
              style="--min:280px"
            >
              <div>
                <p class="mb-3.5 flex items-center gap-3">
                  <span
                    class:list={[
                      'text-[11.5px] font-extrabold tracking-[.09em] uppercase text-blue',
                    ]}
                  >
                    {s.number}
                  </span>
                  <span
                    class:list={[
                      'h-px flex-1',
                      isAircon ? 'bg-blue/25' : 'bg-ink/12',
                    ]}
                    aria-hidden="true"
                  />
                </p>

                <h2 class="h2-row mb-2.5">{s.name}</h2>

                <p
                  class:list={[
                    'm-0 max-w-[60ch] text-[15.5px] leading-[1.65] font-medium text-body',
                    (isAircon || s.number === '01') && 'mb-4',
                  ]}
                >
                  {s.rowBody}
                </p>

                {s.number === '01' && (
                  <a href={s.href} class="text-sm font-extrabold text-blue">
                    Open the boiler page →
                  </a>
                )}

                {isAircon && (
                  <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
                    {AIRCON_CHIPS.map((c) => (
                      <li class="rounded-full bg-white px-3.5 py-2 text-[12.5px] font-bold">
                        {c}
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <Photo
                slug={s.photoSlug}
                caption={s.photoCaption}
                alt={s.photoAlt}
                ratio="16/10"
                radius={12}
                tone={isAircon ? 'pale' : 'light'}
                width={720}
                sizes="(max-width: 860px) 100vw, 42vw"
              />
            </li>
          );
        })
      }
    </ul>
  </section>

  <section class="bg-tint px-6 py-[clamp(40px,5vw,64px)]">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-5">
      <div>
        <h2 class="m-0 mb-2 text-[clamp(24px,2.8vw,32px)] font-extrabold tracking-[-.03em]">
          Need one of these booked in?
        </h2>
        <p class="m-0 text-base font-medium text-body">
          Free quote, fixed price, no callout charge on quoted work.
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={CONTACT_ROUTE} class="btn btn-primary" style="padding:16px 26px">
          Request a quote
        </a>
        <a
          href={`tel:${BUSINESS.mobile.tel}`}
          data-track="call"
          class="btn btn-outline"
          style="padding:16px 26px"
        >
          {BUSINESS.mobile.display}
        </a>
      </div>
    </div>
  </section>
</Base>
