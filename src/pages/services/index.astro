---
import Base from '~/layouts/Base.astro';
import PageHeader from '~/components/PageHeader.astro';
import Icon from '~/components/Icon.astro';
import Photo from '~/components/Photo.astro';
import { CONTACT_ROUTE, SERVICES } from '~/data/site';

const itemCount = SERVICES.reduce(
  (n, s) => n + s.domestic.length + s.commercial.length + (s.specialised?.length ?? 0),
  0
);
---

<Base
  title="Our Services | Plumbing, Heating & Gas | OK Plumbing"
  description="Six service areas across London: boilers and heating, plumbing, leak detection, gas safety, bathrooms and kitchens, and air conditioning. Free fixed quotes."
>
  <PageHeader
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Services' }]}
    title="Everything we do, in one place"
    titleClass="max-w-[20ch]"
    intro={`Six service areas and ${itemCount} jobs across domestic and commercial property in Greater London. Free quotes, fixed written prices and Gas Safe registered engineers on every gas job.`}
  />

  <section class="section-sm bg-white px-6">
    <ul class="autogrid mx-auto m-0 max-w-[1240px] list-none gap-5 p-0" style="--min:300px">
      {
        SERVICES.map((s) => (
          <li class="card-lift flex flex-col overflow-hidden rounded-card border border-ink/9 bg-tint">
            <Photo
              slug={s.photoSlug}
              caption={s.photoCaption}
              alt={s.photoAlt}
              ratio="16/10"
              radius={0}
              width={560}
              sizes="(max-width: 860px) 100vw, 33vw"
            />
            <div class="flex flex-1 flex-col gap-3.5 px-7 pt-[26px] pb-[26px]">
              <div class="flex items-center justify-between">
                <span class="flex size-[46px] items-center justify-center rounded-tile bg-pale text-blue">
                  <Icon name={s.icon} />
                </span>
                <span class="text-xs font-bold text-cardnum">{s.number}</span>
              </div>

              <h2 class="m-0 text-[22px] font-extrabold tracking-[-.02em]">{s.name}</h2>

              <p class="m-0 text-[14.5px] leading-[1.6] font-medium text-cardtext">{s.cardBody}</p>

              <p class="m-0 text-[13px] font-semibold text-meta">
                {s.domestic.length + s.commercial.length + (s.specialised?.length ?? 0)} jobs listed
              </p>

              <a href={s.href} class="mt-auto text-[13.5px] font-extrabold text-blue">
                See {s.shortName.toLowerCase()} →
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-tint px-6 py-[clamp(40px,5vw,64px)]">
    <div class="mx-auto flex max-w-[1240px] flex-wrap items-center justify-between gap-5">
      <div>
        <h2 class="m-0 mb-2 text-[clamp(24px,2.8vw,32px)] font-extrabold tracking-[-.03em]">
          Need one of these booked in?
        </h2>
        <p class="m-0 text-base font-medium text-body">
          Free quote, fixed price, no callout charge on quoted work.
        </p>
      </div>
      <a href={CONTACT_ROUTE} class="btn btn-primary" style="padding:16px 28px">Get a free quote</a>
    </div>
  </section>
</Base>
