---
import { BUSINESS, CONTACT_ROUTE } from '~/data/site';
---

<nav
  aria-label="Call or request a quote"
  class="callbar fixed inset-x-0 bottom-0 z-60 grid-cols-2 gap-2.5 border-t border-ink/12 bg-white/97 px-4 py-3 backdrop-blur-sm"
>
  <a
    href={`tel:${BUSINESS.mobile.tel}`}
    data-track="call"
    class="rounded-[9px] bg-ink px-4 py-[15px] text-center text-[14.5px] font-extrabold text-white transition-colors hover:bg-ink-hover hover:text-white"
  >
    Call now
  </a>
  <a
    href={CONTACT_ROUTE}
    class="rounded-[9px] bg-orange px-4 py-[15px] text-center text-[14.5px] font-extrabold text-ink transition-colors hover:bg-orange-hover hover:text-ink"
  >
    Free quote
  </a>
</nav>
