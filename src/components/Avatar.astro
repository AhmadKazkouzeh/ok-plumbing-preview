---
/**
 * Initials avatar.
 *
 * Deliberately not a face. These sit next to real named people — the three
 * engineers, and real Google reviewers — so a stock photograph of a stranger
 * would be telling the visitor something untrue about who they are. Initials on
 * a brand colour read as a considered choice rather than a missing image, and
 * they cost nothing to serve.
 *
 * Colours are picked from the name, so the same person is always the same
 * colour, and every one carries white at 4.5:1 or better.
 *
 * Team portraits keep their photo slot: drop a real photograph into
 * `src/assets/photos/<photoSlug>.(jpg|webp…)` and it takes over.
 */
interface Props {
  name: string;
  /** Rendered size in px, for the circle form. */
  size?: number;
  /** `block` fills its container — used at the top of the team cards. */
  shape?: 'circle' | 'block';
  class?: string;
}

const { name, size = 38, shape = 'circle', class: className = '' } = Astro.props;

// White on each of these is 5.11, 7.61, 4.54 and 7.27:1.
const PALETTE = ['#0B72B8', '#08578D', '#BF5817', '#155E75'];

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');

// Sum of char codes — stable across builds, and spread enough for short names.
const hash = [...name].reduce((n, ch) => n + ch.charCodeAt(0), 0);
const background = PALETTE[hash % PALETTE.length];
---

{
  shape === 'circle' ? (
    <span
      class:list={['inline-flex shrink-0 items-center justify-center rounded-full', className]}
      style={`width:${size}px;height:${size}px;background:${background}`}
      aria-hidden="true"
    >
      <span class="font-extrabold text-white" style={`font-size:${Math.round(size * 0.4)}px`}>
        {initials}
      </span>
    </span>
  ) : (
    <span
      class:list={['flex aspect-square w-full items-center justify-center', className]}
      style={`background:${background}`}
      aria-hidden="true"
    >
      <span class="text-[clamp(38px,7vw,58px)] font-extrabold tracking-[-.03em] text-white">
        {initials}
      </span>
    </span>
  )
}
