---
/**
 * A titled list of jobs inside a service category.
 *
 * Two columns from 480px so a fifteen-item list does not become a long scroll,
 * and a `note` renders as quieter text under the item rather than a footnote
 * marker, which nobody follows.
 */
import type { ServiceItem } from '~/data/site';

interface Props {
  title: string;
  items: ServiceItem[];
  tone?: 'light' | 'pale';
}

const { title, items, tone = 'light' } = Astro.props;
---

<div>
  <h3 class="eyebrow mb-4 font-extrabold">{title}</h3>
  <ul
    class="m-0 grid list-none gap-x-7 gap-y-2.5 p-0"
    style="grid-template-columns:repeat(auto-fit,minmax(240px,1fr))"
  >
    {
      items.map((item) => (
        <li class="flex gap-2.5">
          <span
            class:list={[
              'mt-[7px] size-[6px] shrink-0 rounded-full',
              tone === 'pale' ? 'bg-blue' : 'bg-orange',
            ]}
            aria-hidden="true"
          />
          <span class="block">
            <span class="block text-[15px] leading-[1.5] font-semibold text-body">
              {item.name}
            </span>
            {item.note && (
              <span class="mt-0.5 block text-[13px] leading-[1.5] font-medium text-cardtext">
                {item.note}
              </span>
            )}
          </span>
        </li>
      ))
    }
  </ul>
</div>
