---
/**
 * The seven service icons plus the phone icon, exactly as hand-authored in the
 * design file: 24x24 viewBox, fill none, stroke currentColor, 1.7 stroke width,
 * round caps and joins. They inherit colour from their tile.
 *
 * These are final. Do not swap in an icon library.
 */
import type { IconName } from '~/data/site';

interface Props {
  name: IconName | 'phone';
  size?: number;
  class?: string;
}

const { name, size = 26, class: className } = Astro.props;

const PATHS: Record<Props['name'], string> = {
  boiler:
    '<rect x="4" y="3" width="16" height="13" rx="2"/><path d="M8 7h8"/><circle cx="9" cy="12" r="1.3"/><path d="M8 16v5M16 16v5"/>',
  heating:
    '<rect x="3" y="7" width="18" height="11" rx="2"/><path d="M7.5 7v11M12 7v11M16.5 7v11"/><path d="M6 4h12"/>',
  plumbing:
    '<path d="M14.5 3.5a3.5 3.5 0 0 0-4.6 4.6L4 14v6h6l5.9-5.9a3.5 3.5 0 0 0 4.6-4.6l-2.6 2.6-2.8-2.8z"/>',
  maintenance:
    '<circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.4M12 18.6V21M3 12h2.4M18.6 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7"/>',
  bathroom:
    '<path d="M4 11h16v3a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-3z"/><path d="M7 11V6a2.5 2.5 0 0 1 5 0"/><path d="M7 19v2M17 19v2"/>',
  aircon:
    '<rect x="3" y="4" width="18" height="8" rx="2"/><path d="M6.5 8.5h11"/><path d="M8 15c0 1.5-1.5 1.5-1.5 3M12 15c0 2-1.5 2-1.5 4M16 15c0 1.5-1.5 1.5-1.5 3"/>',
  phone:
    '<path d="M5 3.5h3.2l1.6 4-2 1.4a12 12 0 0 0 6.3 6.3l1.4-2 4 1.6V18a2.5 2.5 0 0 1-2.7 2.5A16.5 16.5 0 0 1 2.5 6.2A2.5 2.5 0 0 1 5 3.5z"/>',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  class={className}
  style={`width:${size}px;height:${size}px;display:block`}
  set:html={PATHS[name]}
/>
