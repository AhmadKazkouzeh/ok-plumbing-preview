---
import Icon from './Icon.astro';
import { BUSINESS, CONTACT_ROUTE, NAV, SERVICES } from '~/data/site';

const trim = (p: string) => p.replace(/\/+$/, '') || '/';
const path = trim(Astro.url.pathname);
const isCurrent = (href: string) => path === trim(href);
---

<header
  class="sticky top-0 z-50 border-b border-ink/9 bg-white/96 backdrop-blur-[10px]"
  data-header
>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3.5 py-3.5">
    <a href="/" aria-label={`${BUSINESS.name} — home`} class="block shrink-0">
      {/* Inline lockup on desktop; the stacked one below 861px, where the
          one-line version would crowd the hamburger on a narrow phone. */}
      <img
        src="/ok-logo.svg"
        alt={BUSINESS.name}
        width="255"
        height="40"
        fetchpriority="high"
        class="hidden h-10 w-auto nav:block"
      />
      <img
        src="/ok-logo-stacked.svg"
        alt={BUSINESS.name}
        width="159"
        height="46"
        fetchpriority="high"
        class="block h-[46px] w-auto nav:hidden"
      />
    </a>

    <nav
      aria-label="Primary"
      class="hidden flex-wrap gap-x-[22px] gap-y-2 text-[14.5px] font-semibold nav:flex"
    >
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'border-b-2 pb-0.5 transition-colors',
              isCurrent(item.href)
                ? 'border-orange text-ink'
                : 'border-transparent text-body hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden flex-wrap items-center gap-3.5 nav:flex">
      <a
        href={`tel:${BUSINESS.mobile.tel}`}
        data-track="call"
        class="text-base font-extrabold tracking-[-.01em] text-ink hover:text-ink"
      >
        {BUSINESS.mobile.display}
      </a>
      <a
        href={CONTACT_ROUTE}
        class="rounded-lg bg-blue px-[19px] py-3 text-sm font-bold text-white transition-colors hover:bg-blue-hover hover:text-white"
      >
        Free quote
      </a>
    </div>

    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-drawer"
      class="flex size-11 flex-col items-center justify-center gap-[5px] rounded-[10px] bg-ink nav:hidden"
    >
      <span class="sr-only">Menu</span>
      <span class="h-0.5 w-[18px] rounded-sm bg-white" aria-hidden="true"></span>
      <span class="h-0.5 w-[18px] rounded-sm bg-white" aria-hidden="true"></span>
      <span class="h-0.5 w-[18px] rounded-sm bg-white" aria-hidden="true"></span>
    </button>
  </div>

  <div
    id="mobile-drawer"
    data-drawer
    hidden
    class="on-dark border-t border-tint/12 bg-ink px-6 pt-[18px] pb-[26px] text-tint nav:hidden"
  >
    <nav aria-label="Mobile" class="mb-5 grid gap-0.5">
      {
        NAV.map((item, i) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              'py-[13px] text-[22px] font-extrabold tracking-[-.025em] text-tint transition-colors hover:text-cyan',
              i < NAV.length - 1 && 'border-b border-tint/12',
            ]}
          >
            {item.label}
            {item.label === 'Services' && (
              <span class="ml-1.5 text-[13px] font-bold text-cyan">{SERVICES.length}</span>
            )}
          </a>
        ))
      }
    </nav>

    <a
      href={`tel:${BUSINESS.mobile.tel}`}
      data-track="call"
      class="flex items-center gap-3 rounded-[10px] bg-orange p-4 text-ink transition-colors hover:bg-orange-hover hover:text-ink"
    >
      <span
        class="flex size-[38px] shrink-0 items-center justify-center rounded-[9px] bg-ink/15 text-ink"
      >
        <Icon name="phone" />
      </span>
      <span class="block">
        <span class="block text-[10.5px] font-extrabold tracking-[.09em] uppercase">
          Call us
        </span>
        <span class="block text-[18px] font-extrabold tracking-[-.01em]">
          {BUSINESS.mobile.display}
        </span>
      </span>
    </a>

    <p class="mt-3.5 text-[12.5px] font-semibold text-tint/55">
      Gas Safe registered{BUSINESS.gasSafeNumber ? ` ${BUSINESS.gasSafeNumber}` : ''} · {
        BUSINESS.rating.value
      }★ on Google
    </p>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');

  if (toggle && drawer) {
    const focusables = () =>
      Array.from(drawer.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'));

    const setOpen = (open: boolean) => {
      drawer.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      // Stop the page scrolling behind the drawer, which otherwise carries the
      // open menu off the top of the screen.
      // Lock both: the root is the scrolling element, and `overflow-x: clip`
      // on html/body (the sideways-scroll guard in global.css) means locking
      // body alone no longer stops the page moving behind the drawer.
      document.documentElement.style.overflow = open ? 'hidden' : '';
      document.body.style.overflow = open ? 'hidden' : '';
      if (open) focusables()[0]?.focus();
    };

    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true')
    );

    // Navigating closes the drawer (the browser then handles the page change).
    drawer.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (drawer.hidden) return;
      if (e.key === 'Escape') {
        setOpen(false);
        toggle.focus();
        return;
      }
      // Trap focus inside the drawer (plus its toggle) while it is open.
      if (e.key !== 'Tab') return;
      const items = [toggle, ...focusables()];
      const first = items[0]!;
      const last = items[items.length - 1]!;
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // Leaving mobile width resets the drawer so desktop nav is never hidden behind it.
    matchMedia('(min-width: 861px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
