# OK Plumbing and Heating — Apache config for Namecheap shared hosting.
# Copied into dist/ by the build; upload it alongside the rest of dist/.

# ---------------------------------------------------------------------------
# Custom 404. Without this Apache serves its own error page and dist/404.html
# is never used.
# ---------------------------------------------------------------------------
Options -Indexes

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # One canonical host. The canonical URLs in the pages are non-www, so www
  # redirects to it — otherwise both spellings get indexed as separate sites.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Directory URLs get their trailing slash added (Apache default, set explicitly).
<IfModule mod_dir.c>
  DirectorySlash On
  DirectoryIndex index.html
</IfModule>

# ---------------------------------------------------------------------------
# Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
  AddOutputFilterByType DEFLATE text/javascript
</IfModule>

# ---------------------------------------------------------------------------
# Caching. Everything in /_astro/ has a content hash in its filename, so it can
# be cached forever. HTML must not be, or visitors keep seeing the old site.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # Unhashed names — a day, so a replacement reaches people within a day.
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/svg+xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Hashed filenames only: a new build means a new name, so these can never go
  # stale. Scoped by path, not extension — everything outside /_astro/ keeps
  # its name across deploys.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_astro/" HASHED_ASSET=1
    Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
  </IfModule>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers. `always`, so they are set on error responses too — the
  # 404 body is served for every missing URL and would otherwise ship bare.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HTTPS is already forced above; this stops the first redirect being needed.
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Correct types for the fonts and modern image formats.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType image/svg+xml .svg
</IfModule>
